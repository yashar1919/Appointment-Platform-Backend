APP_NAME=Appointment Platform API
APP_ENV=production
DEBUG=false
DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname
DATABASE_SYNC_URL=postgresql+psycopg2://user:pass@host:5432/dbname
CORS_ORIGINS=https://appointment-two-beta.vercel.app
ADMIN_API_KEY=replace-with-a-secret-key
MELI_PAYAMAK_USERNAME=your_username
MELI_PAYAMAK_PASSWORD=your_password
MELI_PAYAMAK_FROM_NUMBER=5000...
